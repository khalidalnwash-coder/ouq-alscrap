PORT=4000
DATABASE_URL=postgres://alscrap:alscrap_dev_pw@localhost:5432/alscrap
JWT_SECRET=change_this_dev_secret
NODE_ENV=development

# The one account allowed into the admin dashboard (GET/POST/PATCH/DELETE
# /api/admin/*) — matched case-insensitively against a user's email on
# every admin request, never cached. Leave empty/unset and nobody is an
# admin, no matter what any user row's old is_admin column says. Set this
# on Render under your service's Environment tab, not in this file.
ADMIN_EMAIL=

# Media storage driver: "local" (dev only — files are lost on every deploy
# on most hosts, including Render's free tier) or "cloudinary" (permanent
# external storage, required in production). See README.md for the 5-minute
# Cloudinary account setup.
#
# IMPORTANT — this line itself must be set to "cloudinary" on Render, in
# addition to the three CLOUDINARY_* values below. Adding only the three
# credentials without this line does NOT switch anything: the server keeps
# silently defaulting to "local" (files on Render's disk, wiped on every
# deploy). On boot the server logs which driver actually ended up active —
# check Render's Logs tab, or GET /api/health — search for "[storage]".
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
PUBLIC_UPLOADS_BASE_URL=/uploads

# Required only when STORAGE_DRIVER=cloudinary (see the note above — that
# line has to say "cloudinary" too, not just these three). Get these values
# from your Cloudinary dashboard (Settings -> API Keys) after creating a
# free account at https://cloudinary.com — see README.md for the exact steps.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OTP delivery (security review follow-up). Without these, codes are only
# logged server-side (never returned to the HTTP caller) — signup/login
# still work for local testing, you just read the code from the server
# console/Render Logs tab instead of a toast. Configure both providers
# before any real launch so users actually receive their codes.
#
# Email — https://resend.com: free account, "API Keys" page in the
# dashboard for RESEND_API_KEY, and "Domains" to verify a sending domain
# (or use their shared onboarding domain for quick testing) for
# OTP_FROM_EMAIL (format: "اسم <otp@yourdomain.com>").
RESEND_API_KEY=
OTP_FROM_EMAIL=

# WhatsApp — https://www.twilio.com: free trial account, Account SID +
# Auth Token from the Twilio Console dashboard home page. Fastest way to
# test is Twilio's WhatsApp Sandbox (Messaging -> Try it out -> Send a
# WhatsApp message) — gives you a shared sandbox number to use as
# TWILIO_WHATSAPP_FROM and a join code testers must send once. Production
# at real scale needs your own approved WhatsApp sender (Twilio walks you
# through Meta's business verification from the same console).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# CORS (security review follow-up). The app's own origin (wherever it's
# actually deployed, e.g. your Render URL) always works automatically with
# no configuration needed — this is only for an ADDITIONAL origin that
# should be allowed to call the API cross-origin (a separate frontend
# domain, a mobile app webview, etc). Comma-separated if more than one.
# Leave empty unless you specifically need this.
ALLOWED_ORIGINS=
