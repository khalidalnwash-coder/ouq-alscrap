PORT=4000
DATABASE_URL=postgres://alscrap:alscrap_dev_pw@localhost:5432/alscrap
JWT_SECRET=change_this_dev_secret
NODE_ENV=development

# The one account allowed into the admin dashboard (GET/POST/PATCH/DELETE
# /api/admin/*) — matched case-insensitively against a user's email on
# every admin request, never cached. Leave empty/unset and nobody is an
# admin, no matter what any user row's old is_admin column says. Set this
# on Render under your service's Environment tab, not in this file.
ADMIN_EMAIL=

# Media storage driver: "local" (dev only — files are lost on every deploy
# on most hosts, including Render's free tier) or "cloudinary" (permanent
# external storage, required in production). See README.md for the 5-minute
# Cloudinary account setup.
#
# IMPORTANT — this line itself must be set to "cloudinary" on Render, in
# addition to the three CLOUDINARY_* values below. Adding only the three
# credentials without this line does NOT switch anything: the server keeps
# silently defaulting to "local" (files on Render's disk, wiped on every
# deploy). On boot the server logs which driver actually ended up active —
# check Render's Logs tab, or GET /api/health — search for "[storage]".
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
PUBLIC_UPLOADS_BASE_URL=/uploads

# Required only when STORAGE_DRIVER=cloudinary (see the note above — that
# line has to say "cloudinary" too, not just these three). Get these values
# from your Cloudinary dashboard (Settings -> API Keys) after creating a
# free account at https://cloudinary.com — see README.md for the exact steps.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
